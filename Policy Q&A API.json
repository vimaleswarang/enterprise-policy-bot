{
  "name": "Policy Q&A API",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const question = $json.body?.question;\n\nif (!question || !question.trim()) {\n  throw new Error('Send a JSON body with a \"question\" field.');\n}\n\nreturn [\n  {\n    json: {\n      question: question.trim(),\n      inputs: [question.trim()],\n    },\n  },\n];"
      },
      "id": "841b3289-97b6-44a7-888f-2e60a001a6ed",
      "name": "Prepare User Question",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.tokenfactory.nebius.com/v1/embeddings",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "Qwen/Qwen3-Embedding-8B"
            },
            {
              "name": "input",
              "value": "={{ $json.inputs }}"
            }
          ]
        },
        "options": {}
      },
      "id": "12091a44-d917-4e9a-94fa-b43c72e6509f",
      "name": "Embed User Question",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "gVjIZcMGqp6wyOx7",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const question = $('Prepare User Question').first().json.question;\nconst vector = $input.first().json.data?.[0]?.embedding;\n\nif (!vector) {\n  throw new Error('Nebius did not return an embedding for the question.');\n}\n\nreturn [\n  {\n    json: {\n      question,\n      vector,\n      topK: 4,\n      includeMetadata: true,\n      namespace: 'acme-policies',\n    },\n  },\n];"
      },
      "id": "839119ab-4d7b-4b80-a906-893a2eed6fa0",
      "name": "Prepare Pinecone Search",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://enterprise-policies-vectors-e7azfim.svc.aped-4627-b74a.pinecone.io/query",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "vector",
              "value": "={{ $json.vector }}"
            },
            {
              "name": "topK",
              "value": "={{ 4 }}"
            },
            {
              "name": "=includeMetadata",
              "value": "={{ true }}"
            },
            {
              "name": "namespace",
              "value": "={{ $json.namespace }}"
            }
          ]
        },
        "options": {}
      },
      "id": "65bca2bb-af17-480a-8bc7-e4928ca9ab2c",
      "name": "Search Pinecone Policies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        -352,
        192
      ],
      "credentials": {
        "httpTemplatedCustomAuth": {
          "id": "oKBXNg3ZljJdlQf9",
          "name": "Pinecone API Auth (Vimaleswaran G)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const question = $('Prepare Pinecone Search').first().json.question;\nconst matches = $input.first().json.matches ?? [];\n\nconst context = matches\n  .map((match, index) => {\n    const metadata = match.metadata ?? {};\n    return [\n      `RESULT ${index + 1}`,\n      `Source: ${metadata.source ?? 'Unknown'}`,\n      `URL: ${metadata.url ?? 'Unknown'}`,\n      `Similarity score: ${match.score ?? 'Unknown'}`,\n      '',\n      metadata.text ?? '',\n    ].join('\\n');\n  })\n  .join('\\n\\n---\\n\\n');\n\nreturn [\n  {\n    json: {\n      question,\n      context: context || 'No relevant policy context was retrieved.',\n      sourceCount: matches.length,\n    },\n  },\n];"
      },
      "id": "fdc5b3f7-6680-4d53-979e-b46478f7d388",
      "name": "Format Retrieved Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -128,
        192
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.tokenfactory.nebius.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "meta-llama/Llama-3.3-70B-Instruct"
            },
            {
              "name": "temperature",
              "value": "={{ 0.1 }}"
            },
            {
              "name": "messages",
              "value": "={{\n  [\n    {\n      role: 'system',\n      content: `You are ACME Corp's Enterprise Policy Q&A assistant.\n\nAnswer only from the retrieved knowledge-base context. Do not use outside knowledge or invent policies.\n\nIf the context does not contain the answer, say:\n\"I could not find that information in the ACME policy knowledge base.\"\n\nGive a concise answer, then add a Sources line that lists the document source name or names used.`\n    },\n    {\n      role: 'user',\n      content:\n        'Employee question:\\n' +\n        $json.question +\n        '\\n\\nRetrieved knowledge-base context:\\n' +\n        $json.context\n    }\n  ]\n}}"
            }
          ]
        },
        "options": {}
      },
